# Kopieer op Node-02 naar .env.mail-relay en zet bestandsrechten op 600.
MAIL_RELAY_TOKEN=replace-with-openssl-rand-hex-32
MAIL_RELAY_PORT=9092
SMTP_HOST=smtp.example.eu
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_ADDRESS=info@globetrotr.nl
SMTP_FROM_NAME=GlobeTrotr
SMTP_ALLOWED_FROM_DOMAINS=globetrotr.nl
