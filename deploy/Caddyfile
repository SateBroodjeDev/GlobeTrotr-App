{
  on_demand_tls {
    ask http://10.0.0.3:9091/tls/ask
  }
}

globetrotr.nl {
  encode zstd gzip
  handle /api/paddle/webhook {
    reverse_proxy 10.0.0.3:9091
  }
  handle /calendar/* {
    reverse_proxy 10.0.0.3:9091
  }
  handle {
    reverse_proxy web:3000
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

www.globetrotr.nl, dashboard.globetrotr.nl {
  redir https://globetrotr.nl{uri} permanent
}

https:// {
  tls {
    on_demand
  }
  encode zstd gzip
  reverse_proxy web:3000
}
