{
  on_demand_tls {
    ask http://10.0.0.3:9091/tls/ask
  }
}

globetrotr.nl {
  encode zstd gzip
  @portalRoutes path /auth /register /oauth-callback /complete-profile /token/* /dashboard /trips/* /account /billing /agency-admin /agency-admin/* /corporate-admin /corporate-admin/* /company-mail /branding /team /analytics /client-portal /invite/* /uitnodiging/* /agency-invite/* /agency-uitnodiging/*
  redir @portalRoutes https://portal.globetrotr.nl{uri} 302
  handle /api/paddle/webhook {
    reverse_proxy 10.0.0.3:9091
  }
  handle /calendar/* {
    reverse_proxy 10.0.0.3:9091
  }
  handle {
    reverse_proxy web:3000
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

www.globetrotr.nl {
  redir https://globetrotr.nl{uri} permanent
}

dashboard.globetrotr.nl {
  redir https://portal.globetrotr.nl{uri} permanent
}

portal.globetrotr.nl {
  encode zstd gzip
  @portalRoot path /
  redir @portalRoot /dashboard 302
  @publicRoutes path /demo /features /mogelijkheden /prijzen /pricing /about /for-groups /for-travelers /for-agencies /roadmap /updates /changelog /privacy /terms /algemene-voorwaarden /refund-policy /terugbetalingsbeleid /known-issues /bekende-problemen /beta /beta-voorwaarden /trip/* /reis/* /quote/*
  redir @publicRoutes https://globetrotr.nl{uri} 302
  handle /calendar/* {
    reverse_proxy 10.0.0.3:9091
  }
  handle {
    reverse_proxy web:3000
  }
  header {
    X-Robots-Tag "noindex, nofollow"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

https:// {
  tls {
    on_demand
  }
  encode zstd gzip
  handle / {
    rewrite * /agency/entry?domain={host}
    reverse_proxy 10.0.0.3:9091
  }
  handle {
    respond "Not found" 404
  }
  header {
    X-Robots-Tag "noindex, nofollow"
    Referrer-Policy "no-referrer"
    -Server
  }
}
