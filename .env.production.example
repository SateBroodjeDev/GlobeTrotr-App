# Kopieer naar .env.production op de server; commit nooit echte waarden.
SUPABASE_URL=https://project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-on-server
SUPABASE_SERVICE_ROLE_KEY=replace-on-server
VITE_SUPABASE_URL=https://project.supabase.co
VITE_SUPABASE_PROJECT_ID=replace-with-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
VITE_TURNSTILE_SITE_KEY=replace-with-public-site-key
SKYLINK_API_KEY=replace-on-server
WORKER_POLL_MS=5000
WORKER_BATCH_SIZE=20
WORKER_HEALTH_PORT=9091
WORKER_BIND_ADDRESS=127.0.0.1
WORKER_HEALTHCHECK_HOSTS=api.open-meteo.com,api.met.no,api.frankfurter.app,data.skylinkapi.com
WORKER_HEALTH_URL=http://worker:9091/health
# Node-01 gebruikt het private Node-02-adres; publiceer deze poort niet op internet.
MAIL_SERVER_HEALTH_URL=http://10.0.0.3:9091/health/mail
# Private malwarescanner voor alle inkomende en uitgaande bedrijfsmailbijlagen.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
# Pas activeren nadat de mailrelay en templates end-to-end zijn getest.
MAIL_DELIVERY_RELAY_URL=
MAIL_DELIVERY_RELAY_TOKEN=
# Gratis zelf gehoste vertaalconcepten. Op Node-02: bind aan het private IP.
# Op Node-01 wijst de API-URL naar Node-02; publiceer poort 5000 nooit publiek.
TRANSLATION_BIND_ADDRESS=10.0.0.3
TRANSLATION_API_URL=http://10.0.0.3:5000/translate
TRANSLATION_API_KEY=
# Inkomende bedrijfsmail via het centrale ZXCS IMAP-postvak of catch-all.
IMAP_HOST=mail.globetrotr.nl
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=replace-on-server
IMAP_PASSWORD=replace-on-server
IMAP_MAILBOX=INBOX
IMAP_SYNC_INTERVAL_MS=60000
IMAP_INITIAL_LOOKBACK_DAYS=14
# Genereer eenmaal met: openssl rand -base64 32
# Dezelfde waarde is nodig op Node-01 (encryptie) en Node-02 (IMAP-decryptie).
MAILBOX_CREDENTIALS_KEY=replace-with-32-byte-base64-key
# Zelf gehoste mailserver op Node-02. De beheer-API blijft op het interne
# Compose-netwerk; gebruik een API-token met alleen account query/create/update.
STALWART_URL=http://stalwart:8080
STALWART_API_TOKEN=replace-on-node-02-only
STALWART_DOMAIN_ID=replace-with-globetrotr-domain-id

# Paddle Billing. Begin met sandbox; zet pas na de volledige acceptatietest op production.
# De client-side token mag naar de browser. API- en webhookkeys uitsluitend server-side.
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_CLIENT_TOKEN=test_replace-with-client-side-token
VITE_PADDLE_PRO_MONTHLY_PRICE_ID=pri_replace-with-pro-monthly-price
VITE_PADDLE_AGENCY_MONTHLY_PRICE_ID=pri_replace-with-agency-monthly-price
VITE_PADDLE_PRO_ONETIME_PRICE_ID=pri_replace-with-pro-one-time-month-price
VITE_PADDLE_AGENCY_ONETIME_PRICE_ID=pri_replace-with-agency-one-time-month-price
PADDLE_API_KEY=pdl_sdbx_apikey_replace-on-server
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace-on-server
# Genereer eenmaal met: openssl rand -hex 32. Exact dezelfde waarde op Node-01 en Node-02.
PADDLE_CHECKOUT_BINDING_SECRET=replace-with-64-hex-characters
# Web Push. Genereer eenmaal met: npx web-push generate-vapid-keys
# Node-01 heeft public key + subject nodig; Node-02 daarnaast de private key.
VAPID_SUBJECT=mailto:info@globetrotr.nl
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
